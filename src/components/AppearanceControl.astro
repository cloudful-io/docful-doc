<div class="theme-picker" data-theme-picker>
  <button
    id="theme-picker-toggle"
    class="theme-picker-trigger"
    type="button"
    aria-label="Change theme, current mode System"
    aria-haspopup="menu"
    aria-expanded="false"
    aria-controls="theme-picker-menu"
    data-theme-picker-toggle
  >
    <svg
      class="theme-picker-icon"
      viewBox="0 0 24 24"
      aria-hidden="true"
      focusable="false"
      data-theme-icon="light"
    >
      <circle cx="12" cy="12" r="4"></circle>
      <path
        d="M12 2v2m0 16v2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M2 12h2m16 0h2M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42"
      ></path>
    </svg>
    <svg
      class="theme-picker-icon"
      viewBox="0 0 24 24"
      aria-hidden="true"
      focusable="false"
      data-theme-icon="dark"
    >
      <path d="M20.2 15.2A8.5 8.5 0 0 1 8.8 3.8 8.5 8.5 0 1 0 20.2 15.2Z"
      ></path>
    </svg>
    <svg
      class="theme-picker-icon"
      viewBox="0 0 24 24"
      aria-hidden="true"
      focusable="false"
      data-theme-icon="auto"
      data-active
    >
      <rect x="3" y="4" width="18" height="13" rx="2"></rect>
      <path d="M8 21h8m-4-4v4"></path>
    </svg>
    <span data-theme-current>System</span>
  </button>
  <div
    id="theme-picker-menu"
    class="theme-picker-menu"
    role="menu"
    aria-labelledby="theme-picker-toggle"
    data-theme-picker-menu
    hidden
  >
    <button
      class="theme-picker-option"
      type="button"
      role="menuitemradio"
      aria-checked="false"
      data-theme-option="light"
    >
      <span>Light</span><span
        class="theme-picker-check"
        data-theme-check
        hidden
        aria-hidden="true">✓</span
      >
    </button>
    <button
      class="theme-picker-option"
      type="button"
      role="menuitemradio"
      aria-checked="false"
      data-theme-option="dark"
    >
      <span>Dark</span><span
        class="theme-picker-check"
        data-theme-check
        hidden
        aria-hidden="true">✓</span
      >
    </button>
    <button
      class="theme-picker-option"
      type="button"
      role="menuitemradio"
      aria-checked="true"
      data-theme-option="auto"
    >
      <span>System</span><span
        class="theme-picker-check"
        data-theme-check
        aria-hidden="true">✓</span
      >
    </button>
  </div>
</div>
