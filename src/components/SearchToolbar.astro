<form class="search-toolbar" role="search" data-search-form>
  <div class="search-field-row">
    <div class="search-input-wrapper">
      <input
        id="wiki-search"
        type="search"
        name="q"
        autocomplete="off"
        aria-label="Search documentation"
        placeholder="Search documentation..."
        class="x:rounded-lg x:px-3 x:py-2 x:transition-all x:w-full x:md:w-64 x:text-base x:leading-tight x:md:text-sm x:bg-black/[.05] x:dark:bg-gray-50/10 x:placeholder:text-gray-600 x:dark:placeholder:text-gray-400 x:contrast-more:border x:contrast-more:border-current x:[&::-webkit-search-cancel-button]:appearance-none"
        data-search-input
      />
      <kbd class="search-shortcut" data-search-shortcut aria-hidden="true"
        >Ctrl K</kbd
      >
    </div>
  </div>
  <div class="search-results" data-search-results hidden>
    <p
      class="search-status"
      data-search-status
      role="status"
      aria-live="polite"
    >
    </p>
    <ol data-search-list></ol>
  </div>
</form>
