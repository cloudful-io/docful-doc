---
import AppearanceControl from "../components/AppearanceControl.astro";
import PageTree from "../components/PageTree.astro";
import SearchToolbar from "../components/SearchToolbar.astro";
import { buildNavigation } from "../lib/wiki";
import { withBase } from "../lib/base";
import { themeStyle } from "../lib/theme";
import { siteConfig } from "../site.config";
import "../styles/global.css";

interface Props {
  title?: string;
  activeId?: string;
  entries: Parameters<typeof buildNavigation>[0];
  toc?: Array<{ depth: number; slug: string; text: string }>;
}

const { title, activeId, entries, toc = [] } = Astro.props;
const tree = buildNavigation(entries);
const brandedTitle = siteConfig.title.trim() || "Documentation";
const documentTitle = title ? `${title} · ${brandedTitle}` : brandedTitle;
const logoUrl = siteConfig.logo.trim() ? withBase(siteConfig.logo.trim()) : "";
const themeVars = themeStyle(siteConfig.theme);
---

<!doctype html>
<html lang="en" data-theme="auto" data-appearance="auto" style={themeVars}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content={siteConfig.theme.primary} />
    <title>{documentTitle}</title>
    <script is:inline>
      try {
        const selected = localStorage.getItem("docful-doc-appearance");
        const preference =
          selected === "light" || selected === "dark" ? selected : "auto";
        const resolved =
          preference === "auto"
            ? window.matchMedia("(prefers-color-scheme: dark)").matches
              ? "dark"
              : "light"
            : preference;
        document.documentElement.dataset.appearance = preference;
        document.documentElement.dataset.theme = resolved;
      } catch {
        document.documentElement.dataset.theme = window.matchMedia(
          "(prefers-color-scheme: dark)",
        ).matches
          ? "dark"
          : "light";
      }
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="site-header">
      <button
        class="sidebar-toggle"
        type="button"
        aria-label="Hide navigation"
        aria-expanded="true"
        aria-controls="wiki-sidebar"
        data-sidebar-toggle
      >
        <svg
          class="sidebar-toggle-icon"
          viewBox="0 0 24 24"
          aria-hidden="true"
          focusable="false"
        >
          <rect x="3.5" y="4" width="17" height="16" rx="2"></rect>
          <path d="M9 4v16M15 9l-3 3 3 3" data-navigation-chevron></path>
        </svg>
      </button>
      <div class="identity">
        {logoUrl && <img class="site-logo" src={logoUrl} alt="" />}
        <a class="site-title" href={import.meta.env.BASE_URL}>{brandedTitle}</a>
      </div>
      <SearchToolbar />
    </header>

    <div class="wiki-layout" data-wiki-layout>
      <aside
        id="wiki-sidebar"
        class="wiki-sidebar"
        aria-label="Documentation navigation"
      >
        <PageTree tree={tree} activeId={activeId} />
        <AppearanceControl />
      </aside>
      <main id="main-content" class="page-main" tabindex="-1">
        <slot />
      </main>
      {
        toc.length > 0 && (
          <aside class="toc-sidebar">
            <details class="page-toc" open>
              <summary>On this page</summary>
              <nav aria-label="On this page">
                <ol>
                  {toc.map((heading) => (
                    <li data-depth={heading.depth}>
                      <a href={`#${heading.slug}`}>{heading.text}</a>
                    </li>
                  ))}
                </ol>
              </nav>
            </details>
          </aside>
        )
      }
    </div>

    <script>
      import "../scripts/navigation";
      import "../scripts/appearance";
      import "../scripts/local-time";
      import "../scripts/copy-page";
      import "../scripts/search-ui";
    </script>
  </body>
</html>
