{
  "name": "docful-doc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "typecheck": "astro check",
    "lint": "prettier --check astro.config.ts src tests scripts package.json package-lock.json tsconfig.json vercel.json .prettierrc.json README.md docs/development.md docs/content-contract.md docs/performance-baseline.md playwright.config.ts playwright.prefix.config.ts playwright.performance.config.ts",
    "test": "vitest run tests/unit",
    "test:e2e": "playwright test",
    "test:prefix": "playwright test --config=playwright.prefix.config.ts --project=chromium-desktop tests/e2e/base-path.spec.ts",
    "test:benchmark": "playwright test --config=playwright.performance.config.ts",
    "benchmark:search": "node scripts/benchmark-search.mjs",
    "build:prefix": "cross-env DOCFUL_BASE_PATH=/docs/ astro build"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.2",
    "astro": "^7.3.6",
    "github-slugger": "^2.0.0",
    "minisearch": "^7.1.2",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.54.2",
    "@types/node": "^24.3.0",
    "cross-env": "^10.0.0",
    "prettier": "^3.6.2",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^5.9.2",
    "vitest": "^5.0.3"
  }
}
